
# Application
APP_NAME=AI Medical Assistant & Clinical Intelligence Platform
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:5173

# PostgreSQL container
POSTGRES_DB=medical_db
POSTGRES_USER=medical_user
POSTGRES_PASSWORD=replace_with_a_strong_random_password

# IMPORTANT: use "postgres" as the hostname inside Docker Compose.
DATABASE_URL=postgresql+psycopg://medical_user:replace_with_a_strong_random_password@postgres:5432/medical_db

# Authentication: use a random secret of at least 32 characters.
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Pinecone
PINECONE_API_KEY=replace_with_your_pinecone_api_key
PINECONE_INDEX_NAME=medical-documents

# Document uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_DOCUMENT_EXTENSIONS=.pdf
